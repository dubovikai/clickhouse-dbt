<clickhouse>
    <users>
        <default>
            <access_management>1</access_management>
            <password>...</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
        </default>
        <looker>
            <password>...</password>
            <access_management>0</access_management>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>important_user</profile>
        </looker>
        <airflow>
            <password>...</password>
            <access_management>0</access_management>
            <named_collection_control>1</named_collection_control>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>important_user</profile>
        </airflow>
    </users>
    <profiles>
        <default>
            <log_queries>0</log_queries>
            <log_query_threads>0</log_query_threads>
        </default>
        <important_user>
            <log_queries>1</log_queries>
            <log_query_threads>0</log_query_threads>
            <min_os_cpu_wait_time_ratio_to_throw>6</min_os_cpu_wait_time_ratio_to_throw>
            <max_os_cpu_wait_time_ratio_to_throw>10</max_os_cpu_wait_time_ratio_to_throw>
        </important_user>
    </profiles>
</clickhouse>